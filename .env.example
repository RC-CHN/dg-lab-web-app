# Local use: docker compose up -d --build
APP_ORIGIN=http://localhost:8787
BIND_ADDRESS=127.0.0.1

# Set your own password (12+ characters) to enable /admin and real devices.
# Blank disables administrator login; isolated demos remain available.
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=168
# Local Node service; containers use their /data volume.
CONNECTION_PRESET_FILE=private/connection-preset.json

# HTTPS: replace this with a domain pointing to your server,
# set APP_ORIGIN=https://your-domain, then enable the https profile.
PANEL_DOMAIN=panel.example.com
